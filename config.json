{
  "model": "gemini-2.5-flash",
  "system_prompt": "Sen yardımsever bir Türkçe asistansın. Sadece izin verilen konularda cevap ver. Kısa ve net cevaplar ver.",

  "allowed_topics": ["programlama", "yazılım", "teknoloji", "matematik"],
  "enforce_topics_with_model": true,

  "banned_words": ["şifre", "password", "hack", "kredi kartı"],
  "banned_regex": ["\\b\\d{11}\\b", "\\b(?:\\d[ -]?){16}\\b"],

  "max_input_chars": 500,
  "max_output_tokens": 400,
  "temperature": 0.7,

  "max_messages_per_session": 20,
  "rate_limit_messages": 5,
  "rate_limit_window_seconds": 60,
  "max_history_turns": 10,

  "log_file": "chat_log.txt"
}
